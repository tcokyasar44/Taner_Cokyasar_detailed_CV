\RequirePackage{pgffor}
\newcommand{\mynames}[1]{\def\my@namelist{#1}}
\newtoggle{boldname}
%% --- Mentee underlining (list set with \mymentees in TC_resume.tex) ---
\def\my@menteelist{}
\newcommand{\mymentees}[1]{\def\my@menteelist{#1}}
\newtoggle{menteename}
\newcommand*{\my@checkmentee}{%
  \global\togglefalse{menteename}%
  \ifdefempty{\my@menteelist}{}{%
    \foreach \my@mfam in \my@menteelist {%
      \ifdefstrequal{\namepartfamily}{\my@mfam}{\global\toggletrue{menteename}}{}%
    }}}
\newcommand*{\my@mentee}[1]{\iftoggle{menteename}{\underline{#1}}{#1}}

\renewcommand*{\mkbibnamefamily}[1]{%
  \my@checkmentee
  \global\togglefalse{boldname}%
  \foreach \my@fname / \my@gname in \my@namelist {%
    \ifboolexpr{ test {\ifdefstrequal{\namepartfamily}{\my@fname}}
                 and
                 test {\ifdefstrequal{\namepartgiven}{\my@gname}}}
      {\global\toggletrue{boldname}}{}%
  }%
  \my@mentee{\iftoggle{boldname}{\textbf{#1\iffieldequalstr{usera}{corresp}{\textsuperscript{*}}{}}}{#1}}%
}

\renewcommand*{\mkbibnamegiven}[1]{%
  \my@checkmentee
  \global\togglefalse{boldname}%
  \foreach \my@fname / \my@gname in \my@namelist{%
    \ifboolexpr{ test {\ifdefstrequal{\namepartfamily}{\my@fname}}
                 and
                 test {\ifdefstrequal{\namepartgiven}{\my@gname}}}
      {\global\toggletrue{boldname}\breakforeach}{}%
  }%
  \my@mentee{\iftoggle{boldname}{\textbf{#1}}{#1}}%
}


