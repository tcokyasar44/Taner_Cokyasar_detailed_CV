\newcommand*\circled[1]{\tikz[baseline=(char.base)]{
   \node[shape=circle,text=white,fill=MarkerColour,font=\sffamily\scriptsize\bfseries,inner sep=1pt,text height=1.35ex,minimum width=1.2em,text centered] (char) {#1};}}
   
%% Reverse (count-down) numbering: each list starts at its total, so the top
%% number is the count. Totals are saved to the .aux file, so the numbers are
%% right from the second LaTeX pass on (Overleaf/latexmk rerun automatically).
\newcounter{bibitem}% number shown
\newcounter{bibseen}% items printed so far in the current list
\newcounter{biblist}% index of the current \printbibliography
\AtBeginBibliography{%
  \stepcounter{biblist}\setcounter{bibseen}{0}%
  \ifcsundef{tcbibtotal\the\value{biblist}}%
    {\setcounter{bibitem}{0}}%
    {\setcounter{bibitem}{\csuse{tcbibtotal\the\value{biblist}}}}}
\newcommand*{\tc@countbibitem}{%
  \stepcounter{bibseen}%
  \immediate\write\@auxout{\noexpand\expandafter\noexpand\gdef\noexpand\csname tcbibtotal\the\value{biblist}\noexpand\endcsname{\the\value{bibseen}}}}
\iffieldformatundef{labelnumberwidth}{%
  % if author-year style
  \AtEveryBibitem{\tc@countbibitem\makebox[2.5em][l]{\circled{\thebibitem}\addtocounter{bibitem}{-1}}}%
}{%
  % if numeric style
  \DeclareFieldFormat{labelnumberwidth}{\makebox[2em][l]{\circled{\thebibitem}}}%
  \setlength{\biblabelsep}{0pt}%
  \AtEveryBibitem{\tc@countbibitem\addtocounter{bibitem}{-1}}%
}
\AtEveryBibitem{\iffieldundef{doi}{}{\clearfield{url}}}

